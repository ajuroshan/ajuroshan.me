interface Props { name: string; size?: number; class?: string; title?: string }
const { name, size = 32, class: cls, title } = Astro.props;
const rows = ICONS[name] ?? ICONS.doc;
const rects: { x: number; y: number; w: number; c: string }[] = [];
rows.forEach((row, y) => {
  let x = 0;
  while (x < 16) {
    const ch = row[x];
    if (ch === '.' || !PAL[ch]) { x++; continue; }
    let x2 = x;
    while (x2 < 16 && row[x2] === ch) x2++;
    rects.push({ x, y, w: x2 - x, c: PAL[ch] });
    x = x2;
  }
});
---
<svg class:list={['px', cls]} width={size} height={size} viewBox="0 0 16 16" shape-rendering="crispEdges" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'}>
  {title && <title>{title}</title>}
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.c} />)}
</svg>
