---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<div class="sunken-panel notes-panel">
  <table class="list interactive">
    <thead><tr><th>Name</th><th class="hide-sm">Modified</th><th class="hide-sm">Tags</th></tr></thead>
    <tbody>
      {posts.map((p) => (
        <tr>
          <td><a class="rowicon" href={`/blog/${p.id}/`}><Icon name="doc" size={16} /><span>{p.data.title}</span></a></td>
          <td class="nowrap hide-sm">{fmt(p.data.date)}</td>
          <td class="hide-sm">{p.data.tags.map((t, i) => <><a href={`/tags/${t}/`}>{t}</a>{i < p.data.tags.length - 1 ? ', ' : ''}</>)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
