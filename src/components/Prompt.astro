---
// A shell prompt line: `ajmal@ajuroshan.me:~/path$ command`
interface Props {
  path?: string;
  cmd: string;
  as?: 'h1' | 'h2' | 'div';
  id?: string;
}
const { path = '~', cmd, as: Tag = 'h2', id } = Astro.props;
const [bin, ...rest] = cmd.split(' ');
---
<Tag class="cmd" id={id}><span class="ps1">ajmal@ajuroshan</span><span class="dim">:</span><span class="path">{path}</span><span class="dim">$ </span>{bin}{rest.length > 0 && <span class="arg"> {rest.join(' ')}</span>}</Tag>
