---
// Hero figure: the shape of most systems I build. Pure SVG + SMIL, no JS.
const flows = [
  { id: 'f1', d: 'M70 70 H150 V190 H200', dur: '2.6s', begin: '0s' },
  { id: 'f2', d: 'M70 190 H200', dur: '2.2s', begin: '-0.7s' },
  { id: 'f3', d: 'M70 310 H150 V190 H200', dur: '2.8s', begin: '-1.3s' },
  { id: 'f4', d: 'M296 190 H330 V110 H370', dur: '2.4s', begin: '-0.4s' },
  { id: 'f5', d: 'M296 190 H330 V270 H370', dur: '2.4s', begin: '-1.6s' },
  { id: 'f6', d: 'M466 110 H500 V70 H520', dur: '2.2s', begin: '-0.9s' },
  { id: 'f7', d: 'M466 270 H500 V310 H520', dur: '2.2s', begin: '-2.0s' },
  { id: 'f8', d: 'M466 110 H500 V190 H520', dur: '2.6s', begin: '-1.1s' },
  { id: 'f9', d: 'M466 270 H500 V190 H520', dur: '2.6s', begin: '-0.2s' },
];
---
<figure class="diagram">
  <svg viewBox="0 0 620 380" role="img" aria-labelledby="dg-title dg-desc">
    <title id="dg-title">System architecture</title>
    <desc id="dg-desc">Clients connect through an Nginx load balancer to two Django application nodes, which use PostgreSQL, Redis and Celery workers.</desc>
    <defs>
      <pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" class="dot" />
      </pattern>
    </defs>
    <rect width="620" height="380" fill="url(#dots)" />

    {flows.map((f) => <path id={f.id} d={f.d} class="wire" />)}

    <g class="node client"><rect x="18" y="52" width="52" height="36" rx="8" /><text x="44" y="75">web</text></g>
    <g class="node client"><rect x="18" y="172" width="52" height="36" rx="8" /><text x="44" y="195">ios</text></g>
    <g class="node client"><rect x="18" y="292" width="52" height="36" rx="8" /><text x="44" y="315">api</text></g>

    <g class="node edge"><rect x="200" y="160" width="96" height="60" rx="10" /><text x="248" y="185">nginx</text><text x="248" y="206" class="sub">tls · lb</text></g>

    <g class="node"><rect x="370" y="84" width="96" height="52" rx="10" /><text x="418" y="104">django</text><text x="418" y="125" class="sub">app-1</text></g>
    <g class="node"><rect x="370" y="244" width="96" height="52" rx="10" /><text x="418" y="264">django</text><text x="418" y="285" class="sub">app-2</text></g>

    <g class="node store"><rect x="520" y="50" width="84" height="40" rx="8" /><text x="562" y="75">postgres</text></g>
    <g class="node store"><rect x="520" y="170" width="84" height="40" rx="8" /><text x="562" y="195">redis</text></g>
    <g class="node store"><rect x="520" y="290" width="84" height="40" rx="8" /><text x="562" y="315">celery</text></g>

    {flows.map((f) => (
      <circle r="3.2" class="packet">
        <animateMotion dur={f.dur} begin={f.begin} repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
          <mpath href={`#${f.id}`} />
        </animateMotion>
      </circle>
    ))}
  </svg>
  <figcaption><span class="num">Fig. 01</span> The shape of most things I build and keep running.</figcaption>
</figure>

<style>
  .diagram {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    padding: 18px 18px 14px;
    box-shadow: 0 1px 0 var(--line), 0 24px 48px -32px rgba(0, 0, 0, 0.18);
  }
  svg { width: 100%; height: auto; }
  .dot { fill: var(--line-strong); }
  .wire { fill: none; stroke: var(--line-strong); stroke-width: 1.5; stroke-dasharray: 3 4; }
  .node rect { fill: var(--surface); stroke: var(--ink); stroke-width: 1.25; }
  .node text { font: 500 14px var(--mono); fill: var(--ink); text-anchor: middle; }
  .node text.sub { font-size: 11px; fill: var(--muted); }
  .client rect { stroke: var(--line-strong); }
  .client text { fill: var(--muted); }
  .edge rect { fill: var(--ink); stroke: var(--ink); }
  .edge text { fill: var(--bg); }
  .edge text.sub { fill: var(--line-strong); }
  .store rect { stroke-dasharray: none; fill: var(--bg); }
  .packet { fill: var(--accent); }
  figcaption {
    margin-top: 10px; padding-top: 12px; border-top: 1px solid var(--line);
    font: 12px/1.4 var(--mono); color: var(--muted);
  }
  .num { color: var(--accent); margin-right: 8px; }
  @media (prefers-reduced-motion: reduce) { .packet { display: none; } }
</style>
