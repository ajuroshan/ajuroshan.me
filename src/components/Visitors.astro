---
// "You are visitor No. 000123", counted on the server from nginx logs (no cookies, no scripts).
import { getStatus } from '../data/status';
const s = await getStatus();
const n = typeof (s as { visitors?: number }).visitors === 'number' ? (s as { visitors?: number }).visitors! : null;
const digits = n === null ? '------' : String(n).padStart(6, '0');
---
<p class="visitors ui" data-visitors>
  You are visitor No. <span class="odo" aria-label={n === null ? 'unknown' : String(n)}>{[...digits].map((d) => <span>{d}</span>)}</span>
</p>
<style>
  .visitors { display: flex; align-items: center; gap: 6px; margin-top: 8px; }
  .odo { display: inline-flex; gap: 1px; padding: 2px; background: #000; box-shadow: inset 1px 1px grey, inset -1px -1px #fff; }
  .odo span { display: inline-block; min-width: 11px; padding: 1px 1px; text-align: center; background: linear-gradient(#222, #000 50%, #222); color: #3f3; font: 700 13px/1.1 'Courier New', Courier, monospace; }
</style>
