---
import '../styles/global.css';
import { execSync } from 'node:child_process';
import pkg from '../../package.json';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = profile.summary } = Astro.props;
const fullTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Release CI sets SITE_VERSION to the tag; local builds fall back to package.json.
const version = process.env.SITE_VERSION ?? `v${pkg.version}`;
let sha = 'dev';
try { sha = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch {}
const repo = 'https://github.com/ajuroshan/ajuroshan.me';
const built = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const nav = [
  { label: 'Paper', href: '/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Notes', href: '/blog/' },
];
const here = Astro.url.pathname;
const isOn = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — notes`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#e8e5de" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="sheet">
      <a class="stamp no-print" href={`${repo}/releases/tag/${version}`} title={`build ${sha}`}>
        {profile.handle}.me:{version} [cs.DC] {built}
      </a>

      <header class="runhead">
        <a href="/" class="sc rh-name">A. Roshan</a>
        <nav class="sc no-print" aria-label="primary">
          {nav.map((n, i) => (
            <>{i > 0 && <span class="sep" aria-hidden="true">·</span>}<a href={n.href} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}</a></>
          ))}
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="colophon">
        <p class="folio" aria-hidden="true">{here === '/' ? '1' : '2'}</p>
        <p class="sc muted small">
          Set in Libertinus · built with Astro · served from Oracle Cloud ·{' '}
          <a href={repo}>source</a>{' · '}<a href={`${repo}/releases/tag/${version}`}>{version}</a>
        </p>
      </footer>
    </div>

    <style>
      .stamp {
        position: absolute; left: 30px; top: 50%;
        transform: translateY(-50%) rotate(180deg);
        writing-mode: vertical-rl;
        font: 400 22px/1 var(--serif);
        color: #bdb8ad; letter-spacing: 0.01em; white-space: nowrap;
        max-height: 90%; overflow: hidden;
      }
      .stamp:hover { color: var(--muted); text-decoration: none; }

      .runhead {
        display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
        padding-bottom: 6px; border-bottom: 0.75px solid var(--rule); margin-bottom: 48px;
        font-size: 0.95em;
      }
      .rh-name { color: var(--ink); }
      .runhead nav { display: flex; gap: 10px; }
      .runhead nav a { color: var(--ink-2); }
      .runhead nav a[aria-current='page'] { color: var(--ink); font-weight: 700; }
      .sep { color: var(--muted); }

      .colophon { margin-top: 64px; text-align: center; }
      .folio { font-size: 0.95em; margin-bottom: 18px; }
      .small { font-size: 0.8em; line-height: 1.6; }
      .colophon a { color: var(--muted); }
      .colophon a:hover { color: var(--ink); }

      @media (max-width: 900px) {
        .stamp { display: none; }
        .runhead { margin-bottom: 32px; }
      }
    </style>
  </body>
</html>
