---
import '../styles/98.css'; // 98.css v0.1.21 by Jordan Scales, MIT, patched for lightningcss
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/profile';
import type { ComponentProps } from 'astro/types';

type Props = ComponentProps<typeof Seo> & { home?: boolean };
const { home = false, ...seo } = Astro.props;
const version = import.meta.env.SITE_VERSION || `v${(await import('../../package.json')).default.version}`;
const menu = [
  { href: '/', label: 'Desktop', icon: 'computer' },
  { href: '/blog/', label: 'Notes', icon: 'folder' },
  { href: '/projects/', label: 'Work', icon: 'computer' },
  { href: '/now/', label: 'System Monitor', icon: 'monitor' },
  { sep: true },
  { href: `mailto:${site.email}`, label: 'Send mail', icon: 'mail' },
  { href: `https://github.com/${site.github}`, label: 'GitHub', icon: 'floppy' },
  { href: '/rss.xml', label: 'RSS feed', icon: 'doc' },
  { sep: true },
  { href: '/shutdown/', label: 'Shut Down...', icon: 'logo' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <Seo {...seo} />
  </head>
  <body>
    <main class:list={['desktop', home ? 'desktop--home' : 'desktop--inner']} id="top">
      <slot />
    </main>

    <nav class="startmenu" id="startmenu" aria-label="Start menu">
      <div class="band">{site.domain}</div>
      <ul>
        {menu.map((m) => m.sep ? <li class="sep" role="separator"></li> : <li><a href={m.href}><Icon name={m.icon!} size={24} />{m.label}</a></li>)}
      </ul>
    </nav>

    <div class="taskbar">
      <button class="start" type="button" aria-expanded="false" aria-controls="startmenu" data-start><Icon name="logo" size={16} />Start</button>
      <span class="task-sep" aria-hidden="true"></span>
      <div class="tasks" data-tasks></div>
      <div class="tray">
        <a href="https://github.com/ajuroshan/ajuroshan.me/releases/latest" class="only-wide" title="Site version">{version}</a>
        <Icon name="clock" size={16} />
        <time data-clock>12:00</time>
      </div>
    </div>

    <script>
      // Windows: focus, drag (desktop only), minimize, close; taskbar buttons; start menu; clock.
      const wins = [...document.querySelectorAll<HTMLElement>('[data-win]')];
      const tasks = document.querySelector<HTMLElement>('[data-tasks]')!;
      const home = document.querySelector('.desktop--home');
      const wide = () => matchMedia('(min-width: 701px)').matches;
      let z = 10;

      const buttons = new Map<HTMLElement, HTMLButtonElement>();
      for (const w of wins) {
        if (w.dataset.task === '0') continue;
        const b = document.createElement('button');
        b.type = 'button';
        const ic = w.querySelector('.title-bar-text svg');
        if (ic) b.appendChild(ic.cloneNode(true));
        const s = document.createElement('span'); s.textContent = w.dataset.title ?? ''; b.appendChild(s);
        b.addEventListener('click', () => {
          if (w.classList.contains('min') || w.classList.contains('closed') || !w.classList.contains('active')) open(w);
          else { w.classList.add('min'); sync(); }
        });
        tasks.appendChild(b); buttons.set(w, b);
      }
      const sync = () => {
        for (const [w, b] of buttons) {
          b.classList.toggle('hidden', w.classList.contains('closed'));
          b.setAttribute('aria-pressed', String(w.classList.contains('active') && !w.classList.contains('min')));
        }
      };
      const focus = (w: HTMLElement) => { wins.forEach((x) => x.classList.remove('active')); w.classList.add('active'); w.style.zIndex = String(++z); sync(); };
      const open = (w: HTMLElement) => { w.classList.remove('min', 'closed'); focus(w); if (!home || !wide()) w.scrollIntoView({ block: 'start', behavior: 'smooth' }); };

      for (const w of wins) {
        w.addEventListener('pointerdown', () => focus(w));
        w.querySelector('[data-min]')?.addEventListener('click', () => { w.classList.add('min'); w.classList.remove('active'); sync(); });
        w.querySelector('[data-close]')?.addEventListener('click', () => { w.classList.add('closed'); w.classList.remove('active'); sync(); });
        const bar = w.querySelector<HTMLElement>('[data-drag]');
        if (bar && home) bar.addEventListener('pointerdown', (e) => {
          if (!wide() || (e.target as HTMLElement).closest('button')) return;
          const r = w.getBoundingClientRect(); const p = (w.offsetParent as HTMLElement).getBoundingClientRect();
          const dx = e.clientX - r.left, dy = e.clientY - r.top;
          const move = (ev: PointerEvent) => { w.style.setProperty('--x', `${Math.max(0, ev.clientX - dx - p.left)}px`); w.style.setProperty('--y', `${Math.max(0, ev.clientY - dy - p.top)}px`); };
          const up = () => { removeEventListener('pointermove', move); removeEventListener('pointerup', up); };
          addEventListener('pointermove', move); addEventListener('pointerup', up); e.preventDefault();
        });
      }
      // desktop icons and links that open a window on this page
      document.querySelectorAll<HTMLAnchorElement>('[data-open]').forEach((a) => a.addEventListener('click', (e) => {
        const w = document.getElementById(a.dataset.open!); if (!w) return; e.preventDefault(); open(w);
      }));
      const first = wins.find((w) => w.classList.contains('active')) ?? wins[0];
      if (first) focus(first);

      // start menu
      const start = document.querySelector<HTMLButtonElement>('[data-start]')!;
      const sm = document.getElementById('startmenu')!;
      const setMenu = (on: boolean) => { sm.classList.toggle('open', on); start.setAttribute('aria-expanded', String(on)); };
      start.addEventListener('click', (e) => { e.stopPropagation(); setMenu(!sm.classList.contains('open')); });
      document.addEventListener('click', (e) => { if (!sm.contains(e.target as Node)) setMenu(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

      // clock
      const clock = document.querySelector<HTMLElement>('[data-clock]')!;
      const tick = () => { clock.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); };
      tick(); setInterval(tick, 15_000);
    </script>
  </body>
</html>
