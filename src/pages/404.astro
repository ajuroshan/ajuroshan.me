---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <article class="paper nf">
    <h1>Error 404: Reference Not Found</h1>
    <p class="noindent">The page you cited does not exist. It may have been moved, or the link contains a typo.</p>
    <p class="noindent">See instead: <a href="/">the main paper</a>, <a href="/projects/">Appendix A</a>, or <a href="/blog/">the notes</a>.</p>
  </article>
</Base>
<style>
  .nf { text-align: center; padding: 3em 0 4em; }
  h1 { font-weight: 400; font-size: 1.7em; margin-bottom: 1em; }
  .nf p + p { margin-top: 0.6em; }
</style>
