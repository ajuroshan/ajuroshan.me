---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description}>
  <article class="paper">
    <header class="titleblock">
      <h1>{post.data.title}</h1>
      <p>{profile.name}</p>
      <p class="mono"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      <p class="date">{date}</p>
    </header>

    <section class="abstract justify">
      <h2 class="unnumbered abs-h">Abstract</h2>
      <p>{post.data.description}</p>
    </section>
    {post.data.tags.length > 0 && (
      <p class="keywords noindent"><b><i>Keywords</i></b>&ensp;{post.data.tags.join(' · ')}</p>
    )}

    <div class="prose"><Content /></div>

    <p class="back noindent"><a href="/blog/">← All notes</a></p>
  </article>
</Base>

<style>
  .titleblock { text-align: center; margin-bottom: 2em; }
  h1 { font-size: 1.85em; font-weight: 400; line-height: 1.2; margin-bottom: 0.6em; }
  .titleblock .mono { font-size: 0.8em; margin-top: 0.2em; }
  .date { margin-top: 0.8em; }
  .abstract { margin: 0 3.6em; font-size: 0.9em; }
  .abs-h { text-align: center; font-size: 1em; margin: 0 0 0.4em; }
  .keywords { margin: 1.2em 3.6em 0; font-size: 0.9em; }

  .prose { margin-top: 2.2em; }
  .prose :global(p) { margin: 0; text-align: justify; hyphens: auto; -webkit-hyphens: auto; }
  .prose :global(p + p) { text-indent: 1.4em; }
  .prose :global(ul), .prose :global(ol) { margin: 0.5em 0 0.8em; padding-left: 1.4em; }
  .prose :global(ul li::marker) { content: '–  '; }
  .prose :global(li) { margin-bottom: 0.3em; }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(code) { font-family: var(--mono); font-size: 0.8em; }
  .prose :global(pre) {
    margin: 1.2em 0; padding: 0.8em 0; overflow-x: auto;
    border-top: 0.75px solid var(--rule); border-bottom: 0.75px solid var(--rule);
    background: transparent !important; font-size: 0.82em; line-height: 1.5;
  }
  .prose :global(pre code) { font-size: 1em; }
  .prose :global(blockquote) { margin: 1em 2em; font-size: 0.95em; }
  .prose :global(img) { margin: 1.4em auto; }
  .prose :global(hr) { border: 0; text-align: center; margin: 1.6em 0; }
  .prose :global(hr)::after { content: '* * *'; letter-spacing: 0.6em; color: var(--muted); }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.2em 0; font-size: 0.9em; border-top: 1.5px solid var(--rule); border-bottom: 1.5px solid var(--rule); }
  .prose :global(thead) { border-bottom: 0.75px solid var(--rule); }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 0.35em 0.8em 0.35em 0; }
  .back { margin-top: 3em; }

  @media (max-width: 900px) {
    .abstract { margin: 0 0.6em; }
    .keywords { margin: 1.2em 0.6em 0; }
    .prose :global(p) { text-align: left; }
  }
</style>
