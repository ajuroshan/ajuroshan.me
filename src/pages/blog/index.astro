---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const mins = (s = '') => Math.max(1, Math.round(s.split(/\s+/).filter(Boolean).length / 220));
---
<Base title="Notes" description="Notes on backend systems, infrastructure and operating software in production.">
  <div class="wrap narrow">
    <header class="page-head">
      <p class="kicker">Notes</p>
      <h1 class="inked">From the desk</h1>
      <p class="deck"><i>Write-ups on building and operating backend systems. Newest first. Also by <a href="/rss.xml">RSS</a>.</i></p>
    </header>
    <ol class="list">
      {posts.map((p) => (
        <li>
          <p class="kicker">{fmt(p.data.date)} · {mins(p.body)} min</p>
          <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
          <p class="desc">{p.data.description}</p>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .narrow { max-width: 860px; }
  .page-head { padding: 40px 0 24px; border-bottom: 3px solid var(--ink); }
  h1 { font-size: clamp(48px, 7vw, 88px); letter-spacing: -0.035em; margin: 8px 0 12px; font-variation-settings: 'opsz' 72; }
  .deck { font-size: 1.15em; color: var(--ink-2); }
  .list li { padding: 26px 0; border-bottom: 1px solid rgba(34, 31, 27, 0.35); }
  h2 { font-size: clamp(26px, 3vw, 34px); letter-spacing: -0.015em; margin: 6px 0 8px; }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--spot-ink); }
  .desc { color: var(--ink-2); }
</style>
