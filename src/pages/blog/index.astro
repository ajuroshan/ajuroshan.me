---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Notes" description="Notes on backend systems, infrastructure and operating software in production.">
  <article class="paper">
    <h1>Notes</h1>
    <p class="noindent lede"><i>Write-ups on building and operating backend systems. Newest first. Also available as an <a href="/rss.xml">RSS feed</a>.</i></p>

    <h2 class="unnumbered toc-h">Contents</h2>
    <ol class="toc">
      {posts.map((p, i) => (
        <li>
          <span class="n">{posts.length - i}</span>
          <div class="t">
            <div class="line">
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              <span class="leader" aria-hidden="true"></span>
              <span class="d">{fmt(p.data.date)}</span>
            </div>
            <p class="desc muted">{p.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </article>
</Base>

<style>
  h1 { text-align: center; font-weight: 400; font-size: 1.9em; }
  .lede { text-align: center; margin-top: 0.3em; }
  .toc-h { margin-top: 2em; }
  .toc { list-style: none; padding: 0; margin: 0; }
  .toc li { display: grid; grid-template-columns: 2em 1fr; margin-bottom: 0.9em; }
  .n { font-weight: 700; }
  .line { display: flex; align-items: baseline; gap: 0.5em; }
  .line a { font-weight: 600; color: var(--ink); }
  .line a:hover { color: var(--link); }
  .leader { flex: 1; border-bottom: 1.5px dotted var(--hair); transform: translateY(-0.3em); min-width: 1em; }
  .d { white-space: nowrap; }
  .desc { font-size: 0.9em; margin-top: 0.1em; }
</style>
