---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import Running from '../components/Running.astro';
import { site, projects } from '../data/profile';
import portrait from '../assets/img/ajmal.png';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 5);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
const icons = [
  { href: '/projects/', label: 'My Work', icon: 'computer' },
  { href: '/blog/', label: 'Notes', icon: 'folder' },
  { href: '/now/', label: 'System Monitor', icon: 'monitor' },
  { href: '#welcome', label: 'README.txt', icon: 'doc', open: 'welcome' },
  { href: `mailto:${site.email}`, label: 'Send Mail', icon: 'mail' },
  { href: `https://github.com/${site.github}`, label: 'GitHub', icon: 'floppy' },
  { href: 'https://github.com/ajuroshan/ajuroshan.me/releases/tag/v0.4.0', label: 'Old site', icon: 'bin' },
];
---
<Base title={site.name} description={site.description} home>
  <nav class="icons" aria-label="Desktop">
    {icons.map((i) => (
      <a class="icon" href={i.href} data-open={i.open}><Icon name={i.icon} size={32} /><span>{i.label}</span></a>
    ))}
  </nav>

  <Window id="welcome" title="Welcome" icon="info" x={120} y={30} w={560} active heading={false}>
    <div class="welcome">
      <figure class="portrait">
        <Image src={portrait} width={120} height={120} alt="Ajmal Roshan, black and white" loading="eager" />
      </figure>
      <div class="body">
        <h1 class="h1">Ajmal Roshan</h1>
        <p class="sub"><b>Engineer in Kochi, India.</b></p>
        <p>I build the software a university runs on, gadgets for my motorcycle, and small tools for myself. By day I make iOS apps at Lascade.</p>
        <p>Have a look around. Everything here opens in a window.</p>
      </div>
    </div>
    <div class="welcome-foot">
      <input type="checkbox" id="again" checked /><label for="again">Show this window each time ajmalroshan.dev starts</label>
      <div class="btns">
        <a class="default" href="/blog/">Read the notes</a>
        <a href="/projects/">See the work</a>
        <a href={`mailto:${site.email}`}>Write to me</a>
      </div>
    </div>
  </Window>

  <Window id="notes" title="Notes" icon="folder" x={720} y={20} w={600} menu={['File', 'Edit', 'View', 'Help']} status={[`${posts.length} object(s)`]}>
    <div class="sunken-panel">
      <table class="list interactive">
        <thead><tr><th>Name</th><th>Modified</th><th>Tags</th></tr></thead>
        <tbody>
          {posts.map((p) => (
            <tr>
              <td><a class="rowicon" href={`/blog/${p.id}/`}><Icon name="doc" size={16} />{p.data.title}</a></td>
              <td class="nowrap">{fmt(p.data.date)}</td>
              <td>{p.data.tags.join(', ')}</td>
            </tr>
          ))}
          <tr><td><a class="rowicon" href="/blog/"><Icon name="folder" size={16} />All notes…</a></td><td></td><td></td></tr>
        </tbody>
      </table>
    </div>
  </Window>

  <Window id="work" title="My Work" icon="computer" x={720} y={260} w={600} menu={['File', 'Edit', 'View', 'Help']} status={[`${projects.length} object(s)`]}>
    <div class="iconsgrid">
      {projects.map((p) => (
        <a class="icon" href={`/projects/#${p.slug}`}><Icon name={p.group === 'University' ? 'globe' : p.group === 'Motorcycle' ? 'flag' : 'wrench'} size={32} /><span>{p.name}</span></a>
      ))}
    </div>
  </Window>

  <Window id="monitor" title="System Monitor — arm-free-01" icon="monitor" x={120} y={400} w={580} menu={['File', 'Options', 'View', 'Help']} status={['Live from arm-free-01']}>
    <Running />
    <div class="btns"><a href="/now/">Details</a></div>
  </Window>
</Base>

<style>
  .welcome { display: grid; grid-template-columns: 120px 1fr; gap: 14px; align-items: start; }
  .portrait { margin: 0; box-shadow: inset -1px -1px #fff, inset 1px 1px grey, inset -2px -2px #dfdfdf, inset 2px 2px #0a0a0a; padding: 2px; background: #fff; }
  .portrait img { filter: grayscale(1) contrast(1.1); image-rendering: pixelated; }
  .h1 { font-family: var(--ui); font-size: 22px; font-weight: 700; line-height: 1.1; margin-bottom: 8px; -webkit-font-smoothing: none; }
  .sub { margin-bottom: 0.8em; }
  .welcome-foot { margin-top: 12px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
  .welcome-foot .btns { margin-top: 0; }
  @media (max-width: 520px) { .welcome { grid-template-columns: 1fr; } .portrait { width: 120px; } }
</style>
