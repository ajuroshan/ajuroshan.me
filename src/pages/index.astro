---
import Base from '../layouts/Base.astro';
import Figure1 from '../components/Figure1.astro';
import { getCollection } from 'astro:content';
import { profile, experience, projects, capabilities } from '../data/profile';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const revised = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// References, numbered in order of first citation.
const prod = projects.filter((p) => p.kind === 'prod');
const other = projects.filter((p) => p.kind !== 'prod' && (p.repo || p.url));
const refs = [
  ...prod.map((p) => ({ key: p.name, text: p.title, href: p.url! })),
  ...other.map((p) => ({ key: p.name, text: p.title, href: (p.repo ?? p.url)! })),
  { key: 'github', text: 'Source code and public repositories', href: 'https://github.com/ajuroshan' },
  { key: 'linkedin', text: 'Professional profile', href: 'https://linkedin.com/in/ajuroshan' },
];
const n = (key: string) => refs.findIndex((r) => r.key === key) + 1;
const short = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<Base>
  <article class="paper">
    <header class="titleblock">
      <h1>{profile.name}<a href="#fn1" class="fnref" id="fnref1" aria-label="footnote 1">*</a></h1>
      <p class="role">{profile.role}</p>
      <p class="affil"><i>{profile.location}</i></p>
      <p class="mono"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      <p class="date">Last revised {revised}</p>
    </header>

    <section class="abstract justify">
      <h2 class="unnumbered abs-h">Abstract</h2>
      <p>
        I am a backend and DevOps engineer who designs, ships and operates the software behind
        university admissions, hostel allotment and campus billing at Cochin University of Science
        and Technology. These systems process more than ten thousand applications a year and serve
        several thousand students daily. This page describes that work in the format I read most:
        the systems (§2), the architecture they share (Figure&nbsp;1), my professional experience (§3),
        other projects (§4) and the tools I use (§5).
      </p>
    </section>

    <p class="keywords noindent"><b><i>Keywords</i></b>&ensp;Django · PostgreSQL · Nginx · Docker · CI/CD · Linux · iOS</p>

    <h2>Introduction</h2>
    <p>
      I like owning a system end to end: modelling the data, writing the API, putting it behind a
      load balancer, and being the one who gets paged when it breaks. Most of what I have built
      started as a paper process at my university and ended as software that departments now depend
      on, including the admissions platform <a class="cite" href={`#ref-${n('cusat-fyugp')}`}>[{n('cusat-fyugp')}]</a>,
      hostel allotment <a class="cite" href={`#ref-${n('cusat-hostels')}`}>[{n('cusat-hostels')}]</a>,
      mess billing <a class="cite" href={`#ref-${n('messy')}`}>[{n('messy')}]</a> and the
      cultural-festival registration system <a class="cite" href={`#ref-${n('sargam')}`}>[{n('sargam')}]</a>.
    </p>
    <p>
      I am completing a {profile.education.degree} at {profile.education.school} ({profile.education.year}),
      and currently work on native iOS applications at Lascade Co.
    </p>

    <h2>Systems in Production</h2>
    <p>
      Table&nbsp;1 lists the systems I built and still maintain. Scale figures are approximate and
      refer to regular use, not peak events.
    </p>

    <div class="tbl">
      <table>
        <caption><b>Table 1:</b> Production systems, their scale and stack.</caption>
        <thead>
          <tr><th>System</th><th class="num">Scale</th><th>Stack</th><th class="num">Ref.</th></tr>
        </thead>
        <tbody>
          {prod.map((p) => (
            <tr>
              <td>{p.title}</td>
              <td class="num">{p.metric}</td>
              <td>{p.stack.join(', ')}</td>
              <td class="num"><a href={`#ref-${n(p.name)}`}>[{n(p.name)}]</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {prod.map((p) => (
      <p class="item noindent"><span class="runin">{p.title}.</span>{p.desc} <a class="cite" href={`#ref-${n(p.name)}`}>[{n(p.name)}]</a></p>
    ))}

    <Figure1 />

    <h2>Professional Experience</h2>
    {experience.map((e) => (
      <div class="job">
        <p class="noindent">
          <span class="runin">{e.role},</span> {e.org}. <i class="muted">{e.from} – {e.to}.</i>
        </p>
        <ul class="points">{e.notes.map((x) => <li>{x}</li>)}</ul>
      </div>
    ))}

    <h2>Other Work</h2>
    <p class="noindent">
      Outside production systems I build tools and hardware, mostly to scratch my own itch:
    </p>
    <ul class="points">
      {projects.filter((p) => p.kind !== 'prod').map((p) => (
        <li>
          <i>{p.title}</i> — {p.desc}
          {(p.repo || p.url) && <> <a class="cite" href={`#ref-${n(p.name)}`}>[{n(p.name)}]</a></>}
        </li>
      ))}
    </ul>

    <h2>Tools</h2>
    <div class="tbl">
      <table>
        <caption><b>Table 2:</b> Tools I use regularly, by area.</caption>
        <thead><tr><th>Area</th><th>Tools</th></tr></thead>
        <tbody>
          {capabilities.map((c) => (
            <tr><td class="area">{c.title}</td><td>{c.tools.join(', ')}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    {posts.length > 0 && (
      <>
        <h2>Notes</h2>
        <p class="noindent">Shorter write-ups on building and operating these systems. All notes are listed <a href="/blog/">here</a>; there is also an <a href="/rss.xml">RSS feed</a>.</p>
        <ol class="notes">
          {posts.map((p, i) => (
            <li>
              <span class="nn">{i + 1}.</span>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              <span class="leader" aria-hidden="true"></span>
              <span class="muted nowrap">{fmt(p.data.date)}</span>
            </li>
          ))}
        </ol>
      </>
    )}

    <h2 class="unnumbered">References</h2>
    <ol class="refs">
      {refs.map((r, i) => (
        <li id={`ref-${i + 1}`}>
          <span class="rn">[{i + 1}]</span>
          <span>{r.text}. <a href={r.href} class="mono">{short(r.href)}</a></span>
        </li>
      ))}
    </ol>

    <hr class="fnrule" />
    <p class="footnote noindent" id="fn1">
      <a href="#fnref1">*</a> Correspondence: <a href={`mailto:${profile.email}`}>{profile.email}</a>.
      Open to backend, platform and DevOps roles.
    </p>
  </article>
</Base>

<style>
  .titleblock { text-align: center; margin-bottom: 2.2em; }
  h1 { font-size: 2.1em; font-weight: 400; line-height: 1.15; letter-spacing: 0.005em; margin-bottom: 0.5em; }
  .fnref { font-size: 0.45em; vertical-align: super; margin-left: 0.1em; color: var(--ink); }
  .role { font-size: 1.1em; }
  .affil { margin-top: 0.1em; }
  .titleblock .mono { margin-top: 0.3em; font-size: 0.8em; }
  .date { margin-top: 1em; }

  .abstract { margin: 0 3.6em; font-size: 0.9em; }
  .abs-h { text-align: center; font-size: 1em; margin: 0 0 0.4em; }
  .keywords { margin: 1.3em 3.6em 0; font-size: 0.9em; text-indent: 0; }

  .item { margin-top: 0.7em; }
  .item:first-of-type { margin-top: 0; }
  .job { margin-bottom: 1em; }
  .points { margin: 0.35em 0 0; padding-left: 1.4em; }
  .points li { margin-bottom: 0.25em; }
  .points li::marker { content: '–  '; }
  .area { font-weight: 600; white-space: nowrap; }

  .notes { list-style: none; padding: 0; margin: 0.6em 0 0; }
  .nn { min-width: 1.4em; color: var(--muted); }
  .notes li { display: flex; align-items: baseline; gap: 0.5em; margin-bottom: 0.2em; }
  .leader { flex: 1; border-bottom: 1.5px dotted var(--hair); transform: translateY(-0.3em); min-width: 1em; }
  .nowrap { white-space: nowrap; }

  .refs { list-style: none; padding: 0; margin: 0.6em 0 0; font-size: 0.9em; }
  .refs li { display: grid; grid-template-columns: 2.4em 1fr; margin-bottom: 0.35em; }
  .refs li:target { background: #f6efd6; }
  .rn { color: var(--ink-2); }
  .refs .mono { word-break: break-all; }

  .fnrule { width: 30%; margin: 2.4em 0 0.6em; border: 0; border-top: 0.75px solid var(--rule); }
  .footnote { font-size: 0.82em; }
  .footnote:target { background: #f6efd6; }

  @media (max-width: 900px) {
    .abstract { margin: 0 0.6em; }
    .keywords { margin: 1.2em 0.6em 0; }
    h1 { font-size: 1.8em; }
  }
  @media (max-width: 560px) {
    .tbl { overflow-x: auto; }
    .tbl td:nth-child(3), .tbl th:nth-child(3) { display: none; }
  }
</style>
