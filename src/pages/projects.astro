---
import Base from '../layouts/Base.astro';
import { projects, type Project } from '../data/profile';

const groups: { kind: Project['kind']; title: string; note: string }[] = [
  { kind: 'prod', title: 'Production systems', note: 'Built and maintained by me, with real users.' },
  { kind: 'oss', title: 'Open source', note: 'Tools and hardware with public code.' },
  { kind: 'lab', title: 'Experiments and infrastructure', note: 'Built to learn, or to run everything else.' },
];
const short = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<Base title="Projects" description="A catalogue of production systems, open-source tools and experiments by Ajmal Roshan.">
  <article class="paper appendix">
    <p class="sc muted kicker">Appendix A</p>
    <h1>Project Catalogue</h1>
    <p class="noindent lede">Every project referenced in the <a href="/">main paper</a>, with links and stack.</p>

    {groups.map((g) => (
      <section>
        <h2>{g.title}</h2>
        <p class="noindent muted note"><i>{g.note}</i></p>
        {projects.filter((p) => p.kind === g.kind).map((p) => (
          <div class="entry">
            <h3>{p.title}</h3>
            <p class="noindent">{p.desc}</p>
            <dl class="meta">
              {p.metric && <><dt>Scale</dt><dd>{p.metric}</dd></>}
              <dt>Stack</dt><dd>{p.stack.join(', ')}</dd>
              {p.url && <><dt>Live</dt><dd><a class="mono" href={p.url}>{short(p.url)}</a></dd></>}
              {p.repo && <><dt>Code</dt><dd><a class="mono" href={p.repo}>{short(p.repo)}</a></dd></>}
            </dl>
          </div>
        ))}
      </section>
    ))}
  </article>
</Base>

<style>
  .appendix { counter-reset: sec; }
  .kicker { text-align: center; }
  h1 { text-align: center; font-weight: 400; font-size: 1.9em; margin: 0.1em 0 0.4em; }
  .lede { text-align: center; }
  .note { margin-bottom: 0.4em; }
  .paper h2::before { content: 'A.' counter(sec); min-width: 2.4em; }
  .paper h3::before { content: 'A.' counter(sec) '.' counter(sub); min-width: 3.4em; }
  .entry { margin-bottom: 1.2em; }
  .meta { display: grid; grid-template-columns: max-content 1fr; gap: 0.1em 1.2em; margin: 0.5em 0 0; font-size: 0.9em; }
  .meta dt { font-variant-caps: all-small-caps; letter-spacing: 0.06em; color: var(--muted); }
  .meta dd { margin: 0; }
</style>
