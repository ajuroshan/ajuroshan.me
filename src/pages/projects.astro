---
import Base from '../layouts/Base.astro';
import { projects, type Project } from '../data/profile';

const groups: { kind: Project['kind']; title: string; note: string }[] = [
  { kind: 'prod', title: 'In production', note: 'Systems with real users, run and maintained by me.' },
  { kind: 'oss', title: 'Open source', note: 'Tools and hardware projects with public code.' },
  { kind: 'lab', title: 'Experiments & infrastructure', note: 'Things I built to learn, or to run everything else.' },
];
const host = (u: string) => new URL(u).host;
const short = (u: string) => u.replace('https://github.com/', '');
---
<Base title="Work" description="Production systems, open-source tools and experiments by Ajmal Roshan.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Work</p>
      <h1>Projects</h1>
      <p class="lede">From university platforms serving thousands of students to firmware on a motorcycle. Production first, then the rest.</p>
    </div>
  </section>

  {groups.map((g, gi) => (
    <section class="group">
      <div class="wrap">
        <header class="group-head">
          <p class="eyebrow"><span class="num">{String(gi + 1).padStart(2, '0')}</span>{g.title}</p>
          <p class="muted">{g.note}</p>
        </header>
        <div class="grid">
          {projects.filter((p) => p.kind === g.kind).map((p) => (
            <article class="card">
              <div class="card-top">
                <h2>{p.title}</h2>
                {p.metric && <span class="metric">{p.metric}</span>}
              </div>
              <p class="desc">{p.desc}</p>
              <div class="chips">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
              {(p.url || p.repo) && (
                <div class="card-links mono">
                  {p.url && <a href={p.url} class="link">{host(p.url)} ↗</a>}
                  {p.repo && <a href={p.repo} class="link">{short(p.repo)} ↗</a>}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .page-head { padding: clamp(56px, 8vw, 104px) 0 clamp(32px, 5vw, 56px); }
  h1 { margin-top: 14px; font-size: clamp(44px, 6vw, 80px); letter-spacing: -0.05em; line-height: 1; }
  .lede { margin-top: 20px; max-width: 56ch; font-size: 19px; color: var(--ink-2); }

  .group { padding: 48px 0 64px; border-top: 1px solid var(--line); }
  .group-head { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; flex-wrap: wrap; margin-bottom: 28px; }
  .group-head .muted { font-size: 15px; }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .card {
    display: flex; flex-direction: column; gap: 16px;
    padding: 28px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .card-top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  h2 { font-size: 22px; letter-spacing: -0.025em; }
  .metric { font: 500 12px/1 var(--mono); color: var(--accent); background: var(--accent-soft); padding: 6px 10px; border-radius: 999px; }
  .desc { color: var(--ink-2); flex: 1; }
  .card-links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 13px; padding-top: 16px; border-top: 1px solid var(--line); }
  .num { color: var(--accent); margin-right: 0.6em; }

  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } .card { padding: 22px; } }
</style>
