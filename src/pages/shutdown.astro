---
import Seo from '../components/Seo.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <Seo title="Shut down" description="It is now safe to turn off your computer." noindex />
    <style>
      html { background: #000; }
      body { margin: 0; min-height: 100svh; display: grid; place-items: center; color: #ffa500; font-family: 'Lucida Console', 'Courier New', monospace; font-size: clamp(18px, 3vw, 34px); text-align: center; padding: 24px; }
      a { color: #ffa500; font-size: 14px; display: block; margin-top: 2em; }
    </style>
  </head>
  <body>
    <main>
      <h1>It is now safe to turn off<br />your computer.</h1>
      <a href="/">Or turn it back on.</a>
    </main>
  </body>
</html>
