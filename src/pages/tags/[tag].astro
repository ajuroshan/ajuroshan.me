---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Window from '../../components/Window.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/profile';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Base title={`Notes tagged ${tag}`} description={`${posts.length} note${posts.length === 1 ? '' : 's'} by ${site.name} tagged ${tag}.`}>
  <Window id="tag" title={`Find: files tagged "${tag}"`} icon="folder" w={820} active heading menu={['File', 'Edit', 'View', 'Options', 'Help']} status={[`${posts.length} file(s) found`, 'Searching C:\\Notes']}>
    <div class="sunken-panel">
      <table class="list interactive">
        <thead><tr><th>Name</th><th>Description</th><th>Modified</th></tr></thead>
        <tbody>
          {posts.map((p) => (
            <tr>
              <td class="nowrap"><a class="rowicon" href={`/blog/${p.id}/`}><Icon name="doc" size={16} />{p.data.title}</a></td>
              <td>{p.data.description}</td>
              <td class="nowrap">{fmt(p.data.date)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="btns"><a href="/blog/">All notes</a></div>
  </Window>
</Base>
